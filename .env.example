# =============================================================
#  CAPFLOW — Environment Variables EXAMPLE
#  ✅  This file is safe to commit. It contains NO real secrets.
#  Copy this file to .env and fill in your actual values.
#  $ cp .env.example .env
# =============================================================

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_DB_NAME=Capflow

# ── JWT Auth ──────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret_min_64_chars
JWT_EXPIRY=90d

# ── Email / SMTP (Gmail App Password) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
EMAIL_FROM="CapFlow <your_gmail_address@gmail.com>"

# ── OAuth — Google (MVP) ──────────────────────────────────────
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── OAuth — Facebook (Phase 4 — deferred) ─────────────────────
FACEBOOK_APP_ID=replace_with_facebook_app_id
FACEBOOK_APP_SECRET=replace_with_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# ── OAuth — Apple (Phase 4 — deferred) ───────────────────────
APPLE_CLIENT_ID=replace_with_apple_client_id
APPLE_CLIENT_SECRET=replace_with_apple_client_secret
APPLE_CALLBACK_URL=http://localhost:5000/api/auth/apple/callback

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Analytics (Phase 3 — FastAPI microservice) ────────────────
FASTAPI_ANALYTICS_URL=http://localhost:8000

# ── Feature Flags ─────────────────────────────────────────────
# Set to true only after product/privacy sign-off (see implementation plan)
FEATURE_MONTHLY_STATEMENT=false
